# offline = deterministic keyword rules, no API key needed (tests, demo fallback)
# anthropic / openai = any provider supported by langchain's init_chat_model
LLM_PROVIDER=offline
LLM_MODEL=claude-sonnet-5-5
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2

# Set ANTHROPIC_API_KEY in the environment when LLM_PROVIDER=anthropic.
# Set OPENAI_API_KEY in the environment when LLM_PROVIDER=openai.
# Demo mode serves the built snapshot and shows Reset demo in the UI.
# DEMO_MODE=true
# For an OpenAI-compatible gateway, set OPENAI_BASE_URL in the environment.
